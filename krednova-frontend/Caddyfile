# Caddy gets and renews the HTTPS certificate by itself for the domain in the DOMAIN variable.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 100KB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
